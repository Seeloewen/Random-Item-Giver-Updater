<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="580" d:DesignWidth="742"
             x:Class="RandomItemGiverUpdater.Gui.Pages.ItemRemover.Page2_ItemList">
    <Canvas>
        <Button x:Name="btnContinue" Content="Continue" Height="30" Width="116" Canvas.Left="604" Canvas.Top="535" Click="btnContinue_Click" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
        <Button x:Name="btnBack" Content="Back" Height="30" Width="116" Canvas.Left="474" Canvas.Top="535" Click="btnBack_Click" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
        <Label x:Name="lblHeader" Content="Step 2 - Item List" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="White" FontSize="20" FontWeight="SemiBold" Canvas.Left="12" Canvas.Top="10"/>

        <TextBlock x:Name="tblStep2" Canvas.Left="17" TextWrapping="Wrap" Canvas.Top="54" HorizontalAlignment="Left" VerticalAlignment="Center" Width="690" Text="Please enter the names of the items that you want to remove. The software will then search for these items and show you, where they were found." Foreground="White" FontSize="16"/>
        <TextBox x:Name="tbItems" Canvas.Left="17" TextWrapping="Wrap" Canvas.Top="116" Width="709" HorizontalAlignment="Center" VerticalAlignment="Top" Height="402" FontSize="15" Background="#FF636363" Foreground="White" AcceptsReturn="True"/>
        <CheckBox x:Name="cbIncludesCustomPrefixes" Content="Includes custom prefixes (for example for modded items)" HorizontalAlignment="Center" Canvas.Left="19" Canvas.Top="532" VerticalAlignment="Top" Foreground="White" FontSize="14"/>
    </Canvas>
</UserControl>
