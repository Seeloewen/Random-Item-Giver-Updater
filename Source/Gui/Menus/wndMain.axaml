<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="RandomItemGiverUpdater.Gui.Menus.wndMain"
        Title="Random Item Giver Updater" 
        Height="900" Width="1400" Closing="wndMain_Closing"
        x:CompileBindings="False">
    <Window.Resources>
        <DataTemplate x:Key="ItemTemplate">
            <Canvas x:Name="cvsItem" Height="50" Background="{Binding canvasBackColor}" PointerEntered="cvsItem_MouseEnter" PointerExited="cvsItem_MouseLeave">
                <TextBlock x:Name ="tblItemName" Text="{Binding item.name}" Canvas.Left="15" Canvas.Top="10" FontSize="20" Foreground="White" PointerPressed="tblItemName_MouseDown"/>
                <TextBox x:Name="tbItemName" Width="350" Height="25" FontSize="18" Canvas.Top="8" Canvas.Left="10" IsVisible="False"/>
                <Button x:Name="btnSaveItemName" Height="30" Width="100" Content="Confirm" Canvas.Top="9" Canvas.Left="370" IsVisible="False" Click="btnSaveItemName_Click"/>
                <Button x:Name="btnDelete" Height="30" Width="100" Content="Delete" Canvas.Top="9" Canvas.Right="100" Click="btnDelete_Click" IsVisible="False"/>
                <Button x:Name="btnEditNBTComponent" Height="30" Width="160" Content="Edit NBT/Component" Canvas.Top="9" Canvas.Right="220" IsVisible="False" Click="btnEditNBTComponent_Click"/>
                <TextBlock x:Name="tblEntryIndex" Text="{Binding index}" FontSize="20" TextAlignment="Left" FontWeight="DemiBold" Foreground="White" Canvas.Top="10" Canvas.Right="40"/>
                <TextBlock x:Name="tblIndicator" Text="{Binding indicator.text}" Foreground="{Binding indicator.color}" FontWeight="Bold" FontSize="24" IsVisible="True" Canvas.Top="10" Canvas.Right="225"/>
            </Canvas>
        </DataTemplate>
    </Window.Resources>
    <Grid x:Name="grdWorkspace">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/><ColumnDefinition/>           
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="93"/><RowDefinition/>   
        </Grid.RowDefinitions>
        <StackPanel x:Name="stpSidebar" Background="#FF323232" Grid.RowSpan="2" Grid.ColumnSpan="2"/>
        <StackPanel x:Name="stpHeader" Background="#FF212121" Grid.ColumnSpan="2">
            <Grid>
                <TextBlock x:Name="tblHeader" Text="Random Item Giver Updater" Width="788" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="25" FontWeight="SemiBold" Margin="96,15,0,0"/>
                <TextBox x:Name="tbDatapack" Width="431" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="15" Background="#FF636363" Foreground="White" Margin="0,5,186,0"/>
                <Button x:Name="btnBrowseDatapack" HorizontalAlignment="Right" Height="30" Width="94" Content="Browse" Click="btnBrowseDatapack_Click" VerticalAlignment="Top" HorizontalContentAlignment="Center" Margin="0,6,83,0"/>
                <Button x:Name="btnLoad" Content="Load" Height="30" Width="64" HorizontalAlignment="Right" VerticalAlignment="Top" Click="btnLoad_Click" FontWeight="Bold"  HorizontalContentAlignment="Center" Margin="0,6,11,0"/>
                <Button x:Name="btnSave" Content="Save Loot Table" Height="30" VerticalAlignment="Top" Click="btnSaveLootTable_Click" HorizontalContentAlignment="Left" Margin="0,48,623,0" HorizontalAlignment="Right" Width="170"/>
                <Button x:Name="btnAddItems" Content="Add Items" Width="130" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Click="btnAddItem_Click" HorizontalContentAlignment="Left" Margin="0,48,479,0"/>
                <Image x:Name="imgHeader" Height="74" Width="70" HorizontalAlignment="Left" VerticalAlignment="Top" Source="/Resources/imgIcon.png" Margin="10,10,0,0"/>
                <TextBlock x:Name="tblDatapack" TextWrapping="Wrap" Text="Selected Datapack:"  FontSize="18" Foreground="White" HorizontalAlignment="Right" Margin="0,10,625,0" Height="24" VerticalAlignment="Top"/>
                <Button x:Name="btnDuplicateFinder" Content="Duplicate Finder" Width="170" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" HorizontalContentAlignment="Left" Margin="0,48,126,0" Click="btnDuplicateFinder_Click"/>
                <Button x:Name="btnAbout" Content="About" Width="102" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" HorizontalContentAlignment="Left" Margin="0,48,11,0" Click="btnAbout_Click"/>
                <Button x:Name="btnRemoveItems" Content="Remove Items" Width="154" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Click="btnRemoveItems_Click" HorizontalContentAlignment="Left" Margin="0,48,311,0"/>
            </Grid>
        </StackPanel>
        <ListBox x:Name="lbItems" ItemsSource="{Binding itemEntries}" Grid.Column="1" Grid.Row="1" Background="#FF323232" Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemTemplate}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Image x:Name="imgWorkplace" Grid.Column="1" Margin="308,136,308,178" Grid.Row="1" Source="/Resources/imgWorkplace.png"/>
    </Grid>
</Window>
